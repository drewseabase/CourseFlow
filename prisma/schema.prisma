generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  work 
  personal
  appointment
  other
}

model Event {
  id          String        @id @default(cuid())
  title        String
  startTime   DateTime
  endTime     DateTime
  type        EventType
  color       String
  duration    Int 
  userId      String        @default("temp-user")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}